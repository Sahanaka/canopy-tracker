{
  "permissions": {
    "allow": [
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(jupyter nbconvert:*)",
      "Bash(nbstripout:*)",
      "Bash(pre-commit run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "WebFetch(domain:planetarycomputer.microsoft.com)",
      "WebFetch(domain:www.usgs.gov)",
      "WebFetch(domain:sentiwiki.copernicus.eu)",
      "WebFetch(domain:docs.sentinel-hub.com)",
      "WebFetch(domain:maplibre.org)",
      "WebFetch(domain:docs.pyvista.org)",
      "WebFetch(domain:docs.protomaps.com)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(pip install:*)",
      "Bash(conda:*)",
      "Bash(mamba:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(gh pr merge:*)",
      "Bash(rm -rf data:*)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ruff format --quiet src tests 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
